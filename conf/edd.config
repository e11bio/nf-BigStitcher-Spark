profiles {
    edd {
        params {
            config_profile_contact       = 'Andrew Champion (andrewc@e11.bio)'
            config_profile_name          = 'E11 edd cluster'
            config_profile_description   = 'Slurm cluster "edd" at E11 Bio (slurm-login.1katl.int.f12.bio)'
            config_profile_url           = 'https://www.e11.bio'
            // Single partition; QOS lanes carry the service classes.
            spark_worker_queue           = 'main'
            // Shared SIF cache on the /sw software tier (group edd-users).
            singularity_cache_dir        = '/sw/shared/containers'
            // QOS passthrough (060 contention ruling, 2026-08-25). prepipe
            // emits `slurm_qos` into its params file ONLY when the campaign
            // sets one, so this default keeps the reference below valid for
            // every run that does not — including manual invocations.
            slurm_qos                    = null
        }

        // Fallback work dir on the NAS via the canonical share1-async alias.
        // prepipe passes -w explicitly per step; this covers manual runs.
        // NOTE: deliberately NOT on CephFS /scratch — a Nextflow env-output
        // read raced cross-client visibility there once (2026-08-19,
        // unreproduced synthetically); NAS work dirs are the insurance.
        workDir = '/nas/share1-async/scratch/nextflow'

        // Use Apptainer as the container engine
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false

        process {
            executor = 'slurm'
            // Workload-identity account (edd scheduling model 2026-08-20):
            // imaging-pipeline production bills imgpl-prepipe (fairshare 4
            // via the imgpl parent) rather than the submitter's default
            // account. Applies to every process incl. Spark workers.
            // QOS is folded in next to the account rather than replacing it:
            // the two are orthogonal (account = workload identity/fairshare,
            // QOS = service class). Unset -> submitter's default QOS, which is
            // `normal`. Per 060 this is a wall-time guardrail and workload
            // identity, NOT a priority lever (dev and normal are both
            // priority 0) and NOT a fix for NAS bandwidth contention.
            clusterOptions = params.slurm_qos ? "-A imgpl-prepipe --qos=${params.slurm_qos}" : '-A imgpl-prepipe'

            cpus   = { 1      * task.attempt }
            memory = { 6.GB   * task.attempt }
            time   = { 7.d    * task.attempt }

            errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
            maxRetries    = 3
            maxErrors     = '-1'

            withLabel:process_single {
                cpus   = { 1                   }
                memory = { 6.GB * task.attempt }
                time   = { 7.d  * task.attempt }
                queue  = 'main'
            }
            withLabel:process_low {
                cpus   = { 2     * task.attempt }
                memory = { 12.GB * task.attempt }
                time   = { 7.d   * task.attempt }
                queue  = 'main'
            }
            withLabel:process_medium {
                cpus   = { 6     * task.attempt }
                memory = { 36.GB * task.attempt }
                time   = { 8.h   * task.attempt }
            }
            withLabel:process_high {
                cpus   = { 12    * task.attempt }
                memory = { 72.GB * task.attempt }
                time   = { 16.h  * task.attempt }
            }
            withLabel:process_long {
                time   = { 20.h  * task.attempt }
                queue  = 'main'
            }
            withLabel:process_high_memory {
                memory = { 200.GB * task.attempt }
            }
            withLabel:error_ignore {
                errorStrategy = 'ignore'
            }
            withLabel:error_retry {
                errorStrategy = 'retry'
                maxRetries    = 2
            }

            withName:"SPARK_STARTWORKER" {
                queue = params.spark_worker_queue
                time = '7.d'
            }
            withName:"SPARK_STARTMANAGER" {
                queue = 'main'
                time = '7.d'
            }
        }
    }
}
